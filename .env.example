# ============================================
# 后端环境变量示例（复制为 .env 并按需修改）
# ============================================

# 漫画根目录（必填）
# 服务端将扫描此目录下的所有漫画文件夹
COMIC_ROOT=E:\漫画

# 监听地址（可选，默认 0.0.0.0）
COMIC_HOST=0.0.0.0

# 监听端口（可选，默认 8080）
COMIC_PORT=8080

# 缩略图缓存目录（可选，默认 ~/.comic_reader/cache）
COMIC_CACHE_DIR=

# 缩略图尺寸（可选，默认 320x350）
COMIC_THUMB_W=320
COMIC_THUMB_H=350

# 缓存保留天数（可选，默认 30）
COMIC_CACHE_MAX_AGE_DAYS=30

# 是否允许在服务端打开系统文件管理器（默认 false，需自可信环境）
COMIC_ALLOW_OS_OPEN=false
