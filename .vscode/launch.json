{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File (unittest)",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Run Test Suite",
            "type": "python",
            "request": "launch",
            "module": "unittest",
            "args": ["discover", "-s", "tests", "-p", "test_*.py", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}
