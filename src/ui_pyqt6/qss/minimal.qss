/* ========================================
   极简主义QSS样式表
   基于HTML原型图的视觉规范
   配色：#F8F9FA, #E9ECEF, #4A90E2
   ======================================== */

/* 全局样式 */
* {
    outline: none;
}

/* 主窗口 */
QMainWindow {
    background-color: #F8F9FA;
    color: #2C3E50;
    font-family: 'Inter', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 侧边栏 */
#sidebar {
    background-color: #F8F9FA;
    border-right: 1px solid #E9ECEF;
}

#sidebar QPushButton {
    background-color: transparent;
    color: #6C757D;
    border: none;
    padding: 12px 16px;
    text-align: left;
    font-size: 12px;
    border-radius: 4px;
}

#sidebar QPushButton:hover {
    background-color: #F2F2F2;
    color: #2C3E50;
}

#sidebar QPushButton:pressed {
    background-color: #F2F2F2;
}

#sidebar QPushButton:checked {
    background-color: #4A90E2;
    color: #FFFFFF;
    font-weight: 500;
}

#sidebar QLabel {
    color: #6C757D;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 8px 16px 4px 16px;
}

/* 工具栏 */
#toolbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E9ECEF;
    padding: 8px 16px;
}

#toolbar QPushButton {
    background-color: #F8F9FA;
    color: #2C3E50;
    border: 1px solid #E9ECEF;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 14px;
}

#toolbar QPushButton:hover {
    background-color: #F2F2F2;
    border-color: #4A90E2;
}

#toolbar QPushButton:pressed {
    background-color: #2A6BC5;
    color: #FFFFFF;
}

#toolbar QLineEdit {
    background-color: #F8F9FA;
    color: #2C3E50;
    border: 1px solid #E9ECEF;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 14px;
    selection-background-color: #4A90E2;
}

#toolbar QLineEdit:focus {
    border-color: #4A90E2;
}

#toolbar QComboBox {
    background-color: #F8F9FA;
    color: #2C3E50;
    border: 1px solid #E9ECEF;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 14px;
    min-width: 6em;
}

#toolbar QComboBox:hover {
    border-color: #4A90E2;
}

#toolbar QComboBox::drop-down {
    border: none;
    width: 20px;
}

#toolbar QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #6C757D;
    margin-right: 5px;
}

/* 漫画卡片 */
.album-card {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;
    border-radius: 8px;
}

.album-card:hover {
    border-color: #4A90E2;
}

.album-card QLabel {
    color: #2C3E50;
    font-size: 14px;
}

.album-card QLabel#title {
    font-weight: 500;
}

.album-card QLabel#author {
    color: #6C757D;
    font-size: 12px;
}

.album-card QLabel#rating {
    color: #F39C12;
    font-size: 12px;
}

/* 按钮样式 - 主按钮 */
QPushButton.primary {
    background-color: #4A90E2;
    color: #FFFFFF;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton.primary:hover {
    background-color: #3A7BD5;
}

QPushButton.primary:pressed {
    background-color: #2A6BC5;
}

QPushButton.primary:disabled {
    background-color: #DEE2E6;
    color: #ADB5BD;
}

/* 按钮样式 - 次要按钮 */
QPushButton.secondary {
    background-color: transparent;
    color: #4A90E2;
    border: 1px solid #4A90E2;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton.secondary:hover {
    background-color: #4A90E2;
    color: #FFFFFF;
}

QPushButton.secondary:pressed {
    background-color: #2A6BC5;
}

QPushButton.secondary:disabled {
    border-color: #DEE2E6;
    color: #ADB5BD;
}

/* 按钮样式 - 文字按钮 */
QPushButton.text-button {
    background-color: transparent;
    color: #4A90E2;
    border: none;
    padding: 8px 12px;
    font-size: 14px;
}

QPushButton.text-button:hover {
    color: #3A7BD5;
}

QPushButton.text-button:pressed {
    color: #2A6BC5;
}

/* 输入框 */
QLineEdit {
    background-color: #FFFFFF;
    color: #2C3E50;
    border: 1px solid #E9ECEF;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 14px;
}

QLineEdit:focus {
    border-color: #4A90E2;
}

QLineEdit:disabled {
    background-color: #F2F2F2;
    color: #ADB5BD;
}

/* 网格布局 */
#grid-container {
    background-color: #F8F9FA;
}

#grid-container QScrollArea {
    background-color: #F8F9FA;
    border: none;
}

#grid-container QScrollBar:vertical {
    background-color: #F8F9FA;
    width: 10px;
    border-radius: 5px;
}

#grid-container QScrollBar::handle:vertical {
    background-color: #CBD5E0;
    border-radius: 5px;
    min-height: 20px;
}

#grid-container QScrollBar::handle:vertical:hover {
    background-color: #A0AEC0;
}

#grid-container QScrollBar::add-line:vertical,
#grid-container QScrollBar::sub-line:vertical {
    height: 0;
}

/* 状态栏 */
QStatusBar {
    background-color: #F8F9FA;
    color: #6C757D;
    border-top: 1px solid #E9ECEF;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

/* 标签 */
QLabel {
    color: #2C3E50;
    font-size: 14px;
}

QLabel.muted {
    color: #6C757D;
}

QLabel.small {
    font-size: 12px;
}

QLabel.large {
    font-size: 16px;
}

/* 分割线 */
QFrame.line {
    background-color: #E9ECEF;
}

/* 复选框 */
QCheckBox {
    color: #2C3E50;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #E9ECEF;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #4A90E2;
}

QCheckBox::indicator:checked {
    background-color: #4A90E2;
    border-color: #4A90E2;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAiIGhlaWdodD0iOCIgdmlld0JveD0iMCAwIDEwIDgiIGZpbGw9Im5vbmUiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+CjxwYXRoIGQ9Ik04LjUgMS41TDMuNSA2LjUgMS41IDQuNSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiLz4KPC9zdmc+);
}

/* 单选框 */
QRadioButton {
    color: #2C3E50;
    font-size: 14px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid #E9ECEF;
    background-color: #FFFFFF;
}

QRadioButton::indicator:hover {
    border-color: #4A90E2;
}

QRadioButton::indicator:checked {
    background-color: #4A90E2;
    border-color: #4A90E2;
}

QRadioButton::indicator:checked::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #FFFFFF;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

/* 下拉菜单 */
QComboBox {
    background-color: #F8F9FA;
    color: #2C3E50;
    border: 1px solid #E9ECEF;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 14px;
    min-width: 6em;
}

QComboBox:hover {
    border-color: #4A90E2;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #6C757D;
    margin-right: 5px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;
    border-radius: 6px;
    selection-background-color: #E3F2FD;
    selection-color: #2C3E50;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #F8F9FA;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #E3F2FD;
    color: #2C3E50;
}

/* 滑块 */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #E9ECEF;
    border: none;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #4A90E2;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #3A7BD5;
}

QSlider::sub-page:horizontal {
    background-color: #4A90E2;
    border-radius: 2px;
}

/* 进度条 */
QProgressBar {
    background-color: #F8F9FA;
    border: 1px solid #E9ECEF;
    border-radius: 6px;
    text-align: center;
    font-size: 12px;
    color: #2C3E50;
    height: 16px;
}

QProgressBar::chunk {
    background-color: #4A90E2;
    border-radius: 5px;
}

/* 工具提示 */
QToolTip {
    background-color: #2C3E50;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 12px;
}

/* 菜单 */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    color: #2C3E50;
    padding: 8px 16px;
    border-radius: 4px;
}

QMenu::item:hover {
    background-color: #F8F9FA;
}

QMenu::item:selected {
    background-color: #E3F2FD;
    color: #2C3E50;
}

QMenu::separator {
    height: 1px;
    background-color: #E9ECEF;
    margin: 4px 8px;
}

/* 滚动条全局样式 */
QScrollBar:vertical {
    background-color: #F8F9FA;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E0;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A0AEC0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #F8F9FA;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #CBD5E0;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #A0AEC0;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* 分组框 */
QGroupBox {
    font-weight: 500;
    color: #2C3E50;
    border: 1px solid #E9ECEF;
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    padding: 0 8px;
    background-color: #F8F9FA;
}

/* 表格 */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    selection-background-color: #E3F2FD;
    gridline-color: #E9ECEF;
    border: 1px solid #E9ECEF;
    border-radius: 8px;
}

QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #E9ECEF;
}

QTableWidget::item:selected {
    background-color: #E3F2FD;
    color: #2C3E50;
}

QHeaderView::section {
    background-color: #F8F9FA;
    color: #2C3E50;
    padding: 12px;
    border: none;
    border-bottom: 1px solid #E9ECEF;
    font-weight: 500;
}
